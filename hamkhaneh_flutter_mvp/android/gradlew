#!/usr/bin/env sh
# Lightweight Gradle 8.7 wrapper: downloads the pinned distribution on first use.
set -eu
VERSION=8.7
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/gradle-${VERSION}-bin/hamkhaneh"
GRADLE="$BASE/gradle-${VERSION}/bin/gradle"
if [ ! -x "$GRADLE" ]; then
  mkdir -p "$BASE"
  ARCHIVE="$BASE/gradle-${VERSION}-bin.zip"
  if [ ! -f "$ARCHIVE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fL --retry 3 "https://services.gradle.org/distributions/gradle-${VERSION}-bin.zip" -o "$ARCHIVE"
    else
      echo "curl is required to download Gradle ${VERSION}" >&2; exit 1
    fi
  fi
  unzip -q -o "$ARCHIVE" -d "$BASE"
fi
exec "$GRADLE" "$@"
